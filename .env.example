PORT=3210
# Deployment (leave unset for local single-user use):
# PUBLIC_URL=https://mail.example.edu
# TRUST_PROXY=1
# BIND_HOST=0.0.0.0
# TU_MAIL_DATA_DIR=/data
# LOGIN_IP_PER_MINUTE=10
# LOGIN_ACCOUNT_FAILURES=5
# LOGIN_ACCOUNT_WINDOW_MINUTES=15
# MAX_SESSIONS=2000
# Branding and monitoring (optional):
# BRAND_NAME=Uni Mail
# BRAND_PRIMARY_COLOR=#003366
# BRAND_LOGO=logo.svg          # file inside <TU_MAIL_DATA_DIR>/brand/
# BRAND_HELP_URL=https://help.example.edu/mail
# METRICS_TOKEN=change-me-to-a-long-random-string
# Translate messages to English through your own LibreTranslate server (off when unset):
# TRANSLATE_URL=https://translate.example.edu
# TRANSLATE_API_KEY=
# Optional, for other universities. Only addresses on this domain (and subdomains) may sign in.
# MAIL_EMAIL_DOMAIN=tu-darmstadt.de
# Optional JSON replacing the mailbox types offered at sign-in (operator-set, never client-supplied).
# MAIL_PROFILES={"student":{"host":"imap.example.edu","label":"Student"}}
MAIL_IMAP_HOST=imap.stud.tu-darmstadt.de
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=smtp.tu-darmstadt.de
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
