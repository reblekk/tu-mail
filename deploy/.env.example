# Copy to .env (cp .env.example .env) and adjust. Never put passwords in this file.
PUBLIC_URL=https://tuda-mail.de

# Many students share one public address on campus Wi-Fi, so allow more sign-ins per minute per address.
LOGIN_IP_PER_MINUTE=300

# Outgoing mail server (reachable from the Azure test; imap.stud does not answer on 465 from there).
MAIL_SMTP_HOST=smtp.tu-darmstadt.de

# Stay signed in: sessions are kept (encrypted) on the data volume, survive restarts, and renew with use.
# SESSION_DAYS is how long a sign-in lasts without any visit (each visit renews it). Set SESSION_SECRET to a long random string
# so the key is not stored beside the data.
SESSION_STORE=file
SESSION_DAYS=30
# SESSION_SECRET=a-long-random-string

# Optional (see the README in the project root):
# BRAND_NAME=TUDa Mail
# METRICS_TOKEN=a-long-random-string-of-at-least-16-characters
# TRANSLATE_URL=https://translate.example.edu
